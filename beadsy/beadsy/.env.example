# ============================================================
# Beadsy — environment variables
# Copy to .env (local) or add in Vercel → Project → Settings →
# Environment Variables. NEVER commit real values.
# ============================================================

# --- Core -----------------------------------------------------
# PostgreSQL connection string (Neon, Supabase, Vercel Postgres, RDS ...).
# For poolers (pgbouncer) append ?pgbouncer=true&connection_limit=1 where required.
DATABASE_URL=

# Secret used to sign session cookies. Min 32 chars.
# Generate: openssl rand -base64 48
AUTH_SECRET=

# Public base URL, no trailing slash. Used for canonical URLs, sitemap,
# Stripe redirect URLs and emails. Local: http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Stripe (optional but recommended) ------------------------
# Dashboard → Developers → API keys (use test keys until you go live).
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Dashboard → Developers → Webhooks → endpoint: {SITE_URL}/api/webhooks/stripe
# Local: `stripe listen --forward-to localhost:3000/api/webhooks/stripe`
STRIPE_WEBHOOK_SECRET=

# --- Razorpay (optional) --------------------------------------
# Dashboard → Account & Settings → API keys.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Dashboard → Webhooks → endpoint: {SITE_URL}/api/webhooks/razorpay
# events: payment.captured, order.paid, payment.failed, refund.processed
RAZORPAY_WEBHOOK_SECRET=

# --- Image uploads (admin) ------------------------------------
# Vercel → Storage → Blob. Without it you can still paste image URLs.
BLOB_READ_WRITE_TOKEN=

# --- Email (optional) -----------------------------------------
# https://resend.com — used for order confirmations and password reset.
# Without it, emails are logged to the server console in development only.
RESEND_API_KEY=
EMAIL_FROM="Beadsy <orders@yourdomain.com>"

# --- Cron -----------------------------------------------------
# Secret that protects /api/cron/release-reservations (Vercel sends it as
# "Authorization: Bearer <CRON_SECRET>"). Generate: openssl rand -hex 32
CRON_SECRET=

# --- Seeding --------------------------------------------------
# Creates the first admin account when running `npm run db:seed`.
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Set to "true" to also load the demo catalog (products, categories, sample reviews).
SEED_DEMO=false

# --- Optional storefront links --------------------------------
NEXT_PUBLIC_INSTAGRAM_URL=
NEXT_PUBLIC_CONTACT_EMAIL=
